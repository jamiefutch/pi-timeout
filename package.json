{
  "name": "@jamiefutch/pi-timeout",
  "version": "0.1.4",
  "description": "Pi package: cap run-style bash commands via runTimeout.maxSeconds / fallbackMaxSeconds in settings.json so pi never waits indefinitely.",
  "type": "module",
  "keywords": ["pi","pi-package"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamiefutch/pi-timeout.git"
  },
  "homepage": "https://github.com/jamiefutch/pi-timeout#readme",
  "bugs": {
    "url": "https://github.com/jamiefutch/pi-timeout/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": ["extensions", "src", "LICENSE", "README.md"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": ["./extensions"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
